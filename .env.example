# HubSpot Private App token
HUBSPOT_ACCESS_TOKEN=

# App URL (for links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Intercom (for support tickets)
INTERCOM_ACCESS_TOKEN=

# Google Calendar (for CSM meetings)
GOOGLE_CALENDAR_TOKEN=

# Upsell enrichment
PAPPERS_API_KEY=
# Claude is used for SIREN extraction + autonomous company qualification (web_search)
ANTHROPIC_API_KEY=
CRON_SECRET=

# Supabase — persists enrichment results so each company is enriched at most once.
# Auto-injected by Vercel when Supabase is connected via Storage. The DDL for the
# upsell_enrichments table lives in src/lib/enrichment/storage.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
